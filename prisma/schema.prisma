generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client-v3"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_users {
  id            String    @id @db.Char(36)
  name          String    @db.VarChar(100)
  email         String    @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  role          String    @db.VarChar(50)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
}

model app_devices {
  id                String     @id @db.Char(36)
  device_id         String     @db.VarChar(255)
  device_type       String     @db.VarChar(50)
  app_version       String?    @db.VarChar(20)
  push_token        String?    @db.Text
  notification_enabled Boolean? @default(true)
  push_token_updated_at DateTime? @db.Timestamp(0)
  trial_started_at  DateTime   @db.Timestamp(0)
  trial_expires_at  DateTime   @db.Timestamp(0)
  converted_to_user Boolean?   @default(false)
  user_id           String?    @db.Char(36)
  created_at        DateTime?  @default(now()) @db.Timestamp(0)
  sys_users         sys_users? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_devices_ibfk_1")

  @@index([user_id], map: "user_id")
}

model event_registration {
  id            String    @id @db.Char(36)
  user_id       String    @db.Char(36)
  event_id      String    @db.Char(36)
  registered_at DateTime? @default(now()) @db.Timestamp(0)
  sys_users     sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_registration_ibfk_1")
  events        events    @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "event_registration_ibfk_2")

  @@index([event_id], map: "event_id")
  @@index([user_id], map: "user_id")
}

model events {
  id                 String               @id @db.Char(36)
  title              String               @db.VarChar(255)
  description        String               @db.Text
  event_date         DateTime             @db.Timestamp(0)
  start_time         DateTime?            @db.Time(0)
  end_time           DateTime?            @db.Time(0)
  program_name       String?              @db.VarChar(255)
  address            String?              @db.Text
  state              String?              @db.VarChar(100)
  city               String?              @db.VarChar(100)
  pincode            String?              @db.VarChar(20)
  gallery            String?              @db.Text
  role               String?              @db.VarChar(100)
  legacy_user_id     String?              @db.VarChar(100)
  remark             String?              @db.Text
  contact_person     String?              @db.VarChar(100)
  webinar_url        String?              @db.Text
  webinar_password   String?              @db.Text
  status             String?              @db.VarChar(20)
  comment_reply      String?              @db.Text
  join_link          String?              @db.Text
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  event_registration event_registration[]
}

model otp_verification {
  id           String    @id @db.Char(36)
  phone_number String    @db.VarChar(15)
  otp_code     String    @db.VarChar(6)
  is_verified  Boolean?  @default(false)
  expires_at   DateTime  @db.Timestamp(0)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  meta_data    Json?
}

model pregnancy_day_content {
  id                String    @id @db.Char(36)
  day_number        Int
  meditation_title  String?   @db.VarChar(255)
  meditation_url    String?   @db.Text
  music_url         String?   @db.Text
  youtube_video_url String?   @db.Text
  reading_content   String?   @db.Text
  affirmation       String?   @db.Text
  tips              String?   @db.Text
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  updated_at        DateTime? @default(now()) @db.Timestamp(0)
}

model push_notification_logs {
  id        String    @id @db.Char(36)
  user_id   String    @db.Char(36)
  type      String    @db.VarChar(50)
  sent_at   DateTime  @db.Timestamp(0)
  status    String    @db.VarChar(50)
  sys_users sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "push_notification_logs_ibfk_1")

  @@index([user_id], map: "user_id")
}

model app_notifications {
  id             String    @id @db.Char(36)
  user_id        String    @db.Char(36)
  title          String    @db.VarChar(255)
  message        String    @db.Text
  type           String    @db.VarChar(50)
  category       String?   @db.VarChar(50)
  reference_id   String?   @db.VarChar(100)
  reference_type String?   @db.VarChar(50)
  session        String?   @db.VarChar(20)
  scheduled_for  DateTime? @db.Timestamp(0)
  sent_at        DateTime? @db.Timestamp(0)
  read_at        DateTime? @db.Timestamp(0)
  status         String?   @default("pending") @db.VarChar(30)
  meta_data      Json?
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  sys_users      sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "app_notifications_ibfk_1")

  @@index([user_id], map: "idx_app_notifications_user_id")
  @@index([type], map: "idx_app_notifications_type")
  @@index([status], map: "idx_app_notifications_status")
  @@index([scheduled_for], map: "idx_app_notifications_scheduled_for")
}

model sys_roles {
  id                String           @id @db.Char(36)
  role_name         String           @db.VarChar(50)
  role_code         String           @db.VarChar(50)
  description       String?          @db.Text
  converted_user_id String?          @db.Char(36)
  created_at        DateTime?        @default(now()) @db.Timestamp(0)
  sys_user_roles    sys_user_roles[]
}

model sys_user_roles {
  id          String    @id @db.Char(36)
  user_id     String    @db.Char(36)
  role_id     String    @db.Char(36)
  assigned_at DateTime? @default(now()) @db.Timestamp(0)
  is_verified Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  sys_users   sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sys_user_roles_ibfk_1")
  sys_roles   sys_roles @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sys_user_roles_ibfk_2")

  @@index([role_id], map: "role_id")
  @@index([user_id], map: "user_id")
}

model sys_users {
  id                       String                     @id @db.Char(36)
  full_name                String                     @db.VarChar(100)
  phone_number             String                     @db.VarChar(15)
  email                    String?                    @db.VarChar(150)
  password_hash            String                     @db.Text
  device_id                String                     @db.VarChar(255)
  is_active                Boolean?                   @default(true)
  created_at               DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(0)
  app_devices              app_devices[]
  app_notifications        app_notifications[]
  event_registration       event_registration[]
  push_notification_logs   push_notification_logs[]
  sys_user_roles           sys_user_roles[]
  user_activity_completion user_activity_completion[]
  user_pregnancy_profiles  user_pregnancy_profiles[]
}

model user_activity_completion {
  id           String    @id @db.Char(36)
  user_id      String    @db.Char(36)
  day_number   Int
  activity_id  String    @db.VarChar(50)
  session      String    @db.VarChar(20)
  is_completed Boolean?  @default(false)
  completed_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(0)
  sys_users    sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_activity_completion_ibfk_1")

  @@unique([user_id, day_number, activity_id, session], map: "user_activity_unique")
  @@index([user_id], map: "user_id")
}

model user_pregnancy_profiles {
  id                   String    @id @db.Char(36)
  user_id              String    @db.Char(36)
  pregnancy_start_date DateTime  @db.Date
  due_date             DateTime  @db.Date
  current_week         Int?
  current_day          Int?
  baby_name            String?   @db.VarChar(100)
  doctor_name          String?   @db.VarChar(150)
  hospital_name        String?   @db.VarChar(150)
  created_at           DateTime? @default(now()) @db.Timestamp(0)
  updated_at           DateTime? @default(now()) @db.Timestamp(0)
  sys_users            sys_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_pregnancy_profiles_ibfk_1")

  @@index([user_id], map: "user_id")
}

model activities {
  id               Int                @id @default(autoincrement())
  title            String             @db.VarChar(255)
  description      String?            @db.Text
  activity_type    String?            @db.VarChar(50)
  activity_content activity_content[]
  activity_rules   activity_rules[]
}

model activity_content {
  id          Int                   @id @default(autoincrement())
  activity_id Int
  type        activity_content_type
  url         String                @db.Text
  day_number  Int?
  is_primary  Boolean?              @default(true)
  activities  activities            @relation(fields: [activity_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_content_ibfk_1")

  @@index([activity_id], map: "idx_activity")
}

model activity_rules {
  id          Int                     @id @default(autoincrement())
  activity_id Int
  timeslot    activity_rules_timeslot
  start_day   Int
  end_day     Int
  order_index Int?                    @default(0)
  activities  activities              @relation(fields: [activity_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_rules_ibfk_1")

  @@index([activity_id], map: "activity_id")
  @@index([start_day, end_day], map: "idx_day_range")
  @@index([timeslot], map: "idx_timeslot")
}

enum activity_content_type {
  video
  audio
  text
}

enum activity_rules_timeslot {
  Morning
  Afternoon
  Evening
}
